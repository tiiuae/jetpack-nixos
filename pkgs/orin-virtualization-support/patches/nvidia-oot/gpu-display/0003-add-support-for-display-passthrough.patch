From 615fc45c8887bc7394d4a1ae523bc93c8e86b812 Mon Sep 17 00:00:00 2001
From: Juan Pablo Ruiz <juanpablo.ruiz@unikie.com>
Date: Sun, 19 Jan 2025 23:04:40 +0200
Subject: [PATCH 3/3] Add support for display passthrough on R39

Provide guest display memory allocation and DRAM parameters for passthrough.
---
diff --git a/unifiedgpudisp/kernel-open/nvidia/nv-vm.c b/unifiedgpudisp/kernel-open/nvidia/nv-vm.c
--- a/unifiedgpudisp/kernel-open/nvidia/nv-vm.c
+++ b/unifiedgpudisp/kernel-open/nvidia/nv-vm.c
@@ -334,10 +334,10 @@
     nvl = NV_GET_NVL_FROM_NV_STATE(nv);
     dev = nvl->dev;
 
-    gfp_mask = nv_compute_gfp_mask(nv, at);
+    gfp_mask = GFP_KERNEL | __GFP_ZERO | GFP_DMA;
 
     virt_addr = (unsigned long)dma_alloc_coherent(dev,
-                                                  at->num_pages * PAGE_SIZE,
+                                                  NV_MAX(at->num_pages, 2) * PAGE_SIZE,
                                                   &at->dma_handle,
                                                   gfp_mask);
     if (!virt_addr)
@@ -352,7 +352,7 @@
         page_ptr = &at->page_table[i];
 
         page_ptr->virt_addr = virt_addr + i * PAGE_SIZE;
-        page_ptr->phys_addr = virt_to_phys((void *)page_ptr->virt_addr);
+        page_ptr->phys_addr = at->dma_handle + i * PAGE_SIZE;
     }
 
     if (at->cache_type != NV_MEMORY_CACHED)
@@ -361,6 +361,7 @@
     }
 
     at->flags.coherent = NV_TRUE;
+    at->flags.physical = NV_TRUE;
     return NV_OK;
 }
 
@@ -378,7 +379,7 @@
         nv_set_memory_type(at, NV_MEMORY_WRITEBACK);
     }
 
-    dma_free_coherent(dev, at->num_pages * PAGE_SIZE,
+    dma_free_coherent(dev, NV_MAX(at->num_pages, 2) * PAGE_SIZE,
                       (void *)page_ptr->virt_addr, at->dma_handle);
 }
 
diff --git a/unifiedgpudisp/kernel-open/nvidia/os-interface.c b/unifiedgpudisp/kernel-open/nvidia/os-interface.c
--- a/unifiedgpudisp/kernel-open/nvidia/os-interface.c
+++ b/unifiedgpudisp/kernel-open/nvidia/os-interface.c
@@ -21,6 +21,8 @@
  * DEALINGS IN THE SOFTWARE.
  */
 
+#define NV_DISPLAY_IN_VM 1
+
 #define  __NO_VERSION__
 
 #include "os-interface.h"
@@ -971,7 +973,11 @@
 #if defined(NV_XEN_SUPPORT_FULLY_VIRTUALIZED_KERNEL)
     return (os_is_vgx_hyper());
 #endif
+#if NV_DISPLAY_IN_VM
+    return os_is_vgx_hyper();
+#else
     return NV_FALSE;
+#endif
 }
 
 void* NV_API_CALL os_map_kernel_space(
@@ -1403,7 +1409,7 @@
 
 NvBool NV_API_CALL os_is_xen_dom0(void)
 {
-#if defined(NV_DOM0_KERNEL_PRESENT)
+#if defined(NV_DOM0_KERNEL_PRESENT) || NV_DISPLAY_IN_VM
     return NV_TRUE;
 #else
     return NV_FALSE;
@@ -1412,7 +1418,7 @@
 
 NvBool NV_API_CALL os_is_vgx_hyper(void)
 {
-#if defined(NV_VGX_HYPER)
+#if defined(NV_VGX_HYPER) || NV_DISPLAY_IN_VM
     return NV_TRUE;
 #else
     return NV_FALSE;
diff --git a/unifiedgpudisp/src/nvidia/src/kernel/gpu/disp/kern_disp.c b/unifiedgpudisp/src/nvidia/src/kernel/gpu/disp/kern_disp.c
--- a/unifiedgpudisp/src/nvidia/src/kernel/gpu/disp/kern_disp.c
+++ b/unifiedgpudisp/src/nvidia/src/kernel/gpu/disp/kern_disp.c
@@ -673,6 +673,9 @@
     // but the RmCtrl call still invokes RM boot-time code to collect and
     // process information on its own.
     //
+    /* The guest does not receive the host DRAM topology from BPMP. */
+    params.tegraImpImportData.num_dram_channels = 8;
+
     NV_ASSERT_OK_OR_RETURN(pRmApi->Control(pRmApi, hClient, hSubdevice,
                            NV2080_CTRL_CMD_INTERNAL_DISPLAY_SET_IMP_INIT_INFO,
                            &params, sizeof(params)));
diff --git a/unifiedgpudisp/src/nvidia/src/kernel/gpu/gpu.c b/unifiedgpudisp/src/nvidia/src/kernel/gpu/gpu.c
--- a/unifiedgpudisp/src/nvidia/src/kernel/gpu/gpu.c
+++ b/unifiedgpudisp/src/nvidia/src/kernel/gpu/gpu.c
@@ -3558,4 +3558,5 @@ gpuStatePostLoad
 
+    /* DCE RM does not implement vGPU manager configuration. */
-    if (hypervisorIsVgxHyper())
+    if (hypervisorIsVgxHyper() && !IS_DCE_CLIENT(pGpu))
     {
         NV_CHECK_OK_OR_GOTO(rmStatus,
-- 
