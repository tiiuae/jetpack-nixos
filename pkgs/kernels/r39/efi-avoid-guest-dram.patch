@@ -9,6 +9,23 @@
 
 #include "efistub.h"
 
+/* Graphics passthrough DRAM, in ascending physical address order. */
+static const struct { u64 base, size; } guest_dram[] = {
+	@guestDram@
+};
+
+bool efi_kernel_image_overlaps_guest(u64 start, u64 size)
+{
+	for (size_t i = 0; i < ARRAY_SIZE(guest_dram); i++) {
+		u64 base = guest_dram[i].base;
+
+		if (start < base + guest_dram[i].size &&
+		    (start >= base || size > base - start))
+			return true;
+	}
+	return false;
+}
+
 /*
  * Return the number of slots covered by this entry, i.e., the number of
  * addresses it covers that are suitably aligned and supply enough room
@@ -17,10 +34,12 @@
