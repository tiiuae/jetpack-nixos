 					 unsigned long size,
 					 unsigned long align_shift,
-					 u64 alloc_min, u64 alloc_max)
+					 u64 alloc_min, u64 alloc_max,
+					 unsigned long slot, efi_physical_addr_t *target)
 {
 	unsigned long align = 1UL << align_shift;
-	u64 first_slot, last_slot, region_end;
+	unsigned long total = 0;
+	u64 start = max(md->phys_addr, alloc_min), end;
 
 	if (md->type != EFI_CONVENTIONAL_MEMORY)
 		return 0;
@@ -32,18 +51,26 @@ static unsigned long get_entry_num_slots(efi_memory_desc_t *md,
 	    (md->attribute & EFI_MEMORY_SP))
 		return 0;
 
-	region_end = min(md->phys_addr + md->num_pages * EFI_PAGE_SIZE - 1,
-			 alloc_max);
-	if (region_end < size)
-		return 0;
-
-	first_slot = round_up(max(md->phys_addr, alloc_min), align);
-	last_slot = round_down(region_end - size + 1, align);
-
-	if (first_slot > last_slot)
-		return 0;
-
-	return ((unsigned long)(last_slot - first_slot) >> align_shift) + 1;
+	end = min(md->phys_addr + md->num_pages * EFI_PAGE_SIZE - 1, alloc_max);
+	/* Only complete images between carveouts are eligible for placement. */
+	for (size_t i = 0; i <= ARRAY_SIZE(guest_dram) && start <= end; i++) {
+		u64 last = i == ARRAY_SIZE(guest_dram) ? end :
+			   min(end, guest_dram[i].base - 1);
+		u64 first = round_up(start, align);
+
+		if (first <= last && last - first >= size - 1) {
+			unsigned long n = ((last - first - (size - 1)) >> align_shift) + 1;
+
+			if (target && slot >= total && slot - total < n) {
+				*target = first + (slot - total) * align;
+				return n;
+			}
+			total += n;
+		}
+		if (i < ARRAY_SIZE(guest_dram))
+			start = max(start, guest_dram[i].base + guest_dram[i].size);
+	}
+	return total;
 }
 
